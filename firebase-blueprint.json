{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Storefront product category with optional image and subcategories",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "image": { "type": "string", "maxLength": 600 },
        "subcategories": { "type": "array" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "subcategories", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront garment or intimate apparel item",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "subcategory": { "type": "string", "maxLength": 80 },
        "series": { "type": "string", "maxLength": 80 },
        "pricePkr": { "type": "number" },
        "compareAtPkr": { "type": "number" },
        "image": { "type": "string", "minLength": 1, "maxLength": 600 },
        "gallery": { "type": "array" },
        "fabric": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1500 },
        "highlights": { "type": "array" },
        "careInstructions": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "availability": {
          "type": "string",
          "enum": ["In Stock", "New Arrival", "Best Seller"]
        },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "category", "pricePkr", "image", "availability", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer checkout order placed via storefront",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 3, "maxLength": 32 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "address": { "type": "string", "minLength": 4, "maxLength": 400 },
        "notes": { "type": "string", "maxLength": 400 },
        "paymentMethod": {
          "type": "string",
          "enum": ["Cash on Delivery", "Easypaisa", "JazzCash", "Online Bank Transfer"]
        },
        "items": { "type": "array" },
        "subtotalPkr": { "type": "number" },
        "deliveryPkr": { "type": "number" },
        "totalPkr": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["Confirmed", "Discreetly Packed", "Out for Delivery", "Delivered", "Cancelled"]
        },
        "estimatedWindow": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "orderId",
        "customerName",
        "phone",
        "city",
        "address",
        "paymentMethod",
        "items",
        "subtotalPkr",
        "deliveryPkr",
        "totalPkr",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Publicly readable categories managed by admin"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Publicly readable products managed by admin"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders; anyone can create a confirmed order or lookup by exact orderId, only admin can list/update/delete"
    }
  }
}
